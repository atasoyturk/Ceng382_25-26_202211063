<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - tastemam</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM"
        crossorigin="anonymous" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lato:wght@300;400;700&display=swap"
        rel="stylesheet" />
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
        crossorigin="anonymous" />
</head>
<body>
    <!-- navbar -->
    <nav class="navbar navbar-expand-lg tm-navbar">
        <div class="container">
            <a class="navbar-brand tm-brand" href="/">
                <span class="tm-brand-taste">tastemam</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="fas fa-home me-1"></i>Ana Sayfa</a>
                    </li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-shield-alt me-1"></i>Admin
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="fas fa-tachometer-alt me-2"></i>Panel</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="fas fa-users me-2"></i>Kullanıcılar</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Caretakers"><i class="fas fa-concierge-bell me-2"></i>Caretakerlar</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Orders"><i class="fas fa-shopping-basket me-2"></i>Siparişler</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Ratings"><i class="fas fa-star me-2"></i>Değerlendirmeler</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Logs"><i class="fas fa-list-alt me-2"></i>Sistem Logları</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Caretaker" asp-action="Index"><i class="fas fa-utensils me-2"></i>Menü Yönetimi</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Caretaker"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-concierge-bell me-1"></i>Caretaker
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item" asp-controller="Caretaker" asp-action="Index"><i class="fas fa-utensils me-2"></i>Menü Yönetimi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Caretaker" asp-action="MyOrders"><i class="fas fa-shopping-basket me-2"></i>Siparişler</a></li>
                                    <li><a class="dropdown-item" asp-controller="Caretaker" asp-action="Agreement"><i class="fas fa-file-signature me-2"></i>Sözleşme</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("User"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user me-1"></i>Hesabım
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Dashboard"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Orders"><i class="fas fa-history me-2"></i>Siparişlerim</a></li>
                                    <li><a class="dropdown-item" asp-controller="Cart" asp-action="Index"><i class="fas fa-shopping-basket me-2"></i>Sepetim</a></li>
                                </ul>
                            </li>
                        }

                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="nav-link btn btn-link">
                                    <i class="fas fa-sign-out-alt me-1"></i>Çıkış Yap
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-1"></i>Giriş Yap
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link tm-siparis-btn" asp-controller="Account" asp-action="Register">
                                <i class="fas fa-user-plus me-1"></i>Kayıt Ol
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- container -->
    <div class="container-fluid">
        <div class="row">

            <!-- left bar -->
            <div class="col-lg-2 tm-sidebar d-none d-lg-block">
                <div class="tm-sidebar-inner">
                    <h6 class="tm-sidebar-title">Kategoriler</h6>
                    <ul class="tm-sidebar-list">
                        <li><a href="/"><i class="fas fa-list me-2"></i>Tümü</a></li>
                        <li><a href="/Home/Index?kategori=Düğün"><i class="fas fa-rings-wedding me-2"></i>Düğün</a></li>
                        <li><a href="/Home/Index?kategori=Kurumsal"><i class="fas fa-briefcase me-2"></i>Kurumsal</a></li>
                        <li><a href="/Home/Index?kategori=Özel Gün"><i class="fas fa-birthday-cake me-2"></i>Özel Gün</a></li>
                        <li><a href="/Home/Index?kategori=Mezuniyet"><i class="fas fa-graduation-cap me-2"></i>Mezuniyet</a></li>
                        <li><a href="/Home/Index?kategori=Kokteyl"><i class="fas fa-cocktail me-2"></i>Kokteyl</a></li>
                    </ul>
                    <hr class="tm-sidebar-divider" />
                    <h6 class="tm-sidebar-title">Hızlı Erişim</h6>
                    <ul class="tm-sidebar-list">
                        <li><a href="/Order"><i class="fas fa-plus-circle me-2"></i>Sipariş Ver</a></li>
                        <li><a href="/Contact"><i class="fas fa-phone me-2"></i>Bize Ulaşın</a></li>
                    </ul>
                </div>
            </div>

            <!-- page content -->
            <div class="col-lg-10 tm-main-content">
                @RenderBody()
            </div>

        </div>
    </div>

    <!-- footer -->
    <footer class="tm-footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5 class="tm-footer-brand">
                        <span class="tm-brand-taste">tastemam</span>
                    </h5>
                    <p>Özel anlarınız için her şey tastemam</p>
                </div>
                <div class="col-md-4">
                    <h6>Hızlı Linkler</h6>
                    <ul class="tm-footer-links">
                        <li><a href="/">Ana Sayfa</a></li>
                        <li><a href="/Menu">Menü</a></li>
                        <li><a href="/Contact">İletişim</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6>İletişim</h6>
                    <p><i class="fas fa-phone me-2"></i>+905347977973</p>
                    <p><i class="fas fa-envelope me-2"></i>info@tastemam.com</p>
                    <div class="tm-social">
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-facebook"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                    </div>
                </div>
            </div>
            <hr />
            <p class="text-center tm-copyright">© 2026 tastemam. Tüm hakları saklıdır.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz"
        crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- CHATBOT -->
    <div id="chatbot-container" style="position:fixed; bottom:20px; right:20px; z-index:9999;">
        <button id="chatbot-toggle" onclick="toggleChat()"
                style="width:55px; height:55px; border-radius:50%; background:#C0392B; border:none; color:white; font-size:1.3rem; box-shadow: 0 4px 15px rgba(0,0,0,0.2); cursor:pointer;">
            <i class="fas fa-comments"></i>
        </button>

        <div id="chatbot-box" style="display:none; position:absolute; bottom:65px; right:0; width:320px; background:white; border-radius:12px; box-shadow:0 8px 30px rgba(0,0,0,0.15); overflow:hidden;">
            <div style="background:#1a1a1a; padding:14px 16px; display:flex; justify-content:space-between; align-items:center;">
                <span style="color:white; font-family:'Playfair Display',serif; font-size:0.95rem;">
                    <i class="fas fa-robot me-2" style="color:#C9A84C;"></i>TasteMam Asistan
                </span>
                <button onclick="toggleChat()" style="background:none; border:none; color:#aaa; cursor:pointer;">✕</button>
            </div>

            <div id="chatbot-messages" style="height:300px; overflow-y:auto; padding:12px; background:#f9f9f9;">
                <div style="background:#e8e8e8; padding:10px 12px; border-radius:8px; margin-bottom:8px; font-size:0.88rem;">
                    Merhaba! tastemam hakkında size nasıl yardımcı olabilirim?
                </div>
            </div>

            <div style="padding:10px; background:white; border-top:1px solid #eee; display:flex; gap:8px;">
                <input type="text" id="chatbot-input" placeholder="Mesajınızı yazın..."
                    style="flex:1; border:1px solid #ddd; border-radius:6px; padding:8px 10px; font-size:0.88rem; outline:none;"
                    onkeypress="if(event.key==='Enter') sendMessage()" />
                <button onclick="sendMessage()"
                        style="background:#C0392B; border:none; color:white; padding:8px 12px; border-radius:6px; cursor:pointer;">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>

    <script>
        function toggleChat() {
            const box = document.getElementById('chatbot-box');
            box.style.display = box.style.display === 'none' ? 'block' : 'none';
        }

        async function sendMessage() {
            const input = document.getElementById('chatbot-input');
            const messages = document.getElementById('chatbot-messages');
            const message = input.value.trim();
            if (!message) return;

            messages.innerHTML += `
                <div style="text-align:right; margin-bottom:8px;">
                    <span style="background:#C0392B; color:white; padding:8px 12px; border-radius:8px; font-size:0.88rem; display:inline-block;">
                        ${message}
                    </span>
                </div>`;

            input.value = '';
            messages.scrollTop = messages.scrollHeight;

            const loadingId = 'loading-' + Date.now();
            messages.innerHTML += `
                <div id="${loadingId}" style="background:#e8e8e8; padding:10px 12px; border-radius:8px; margin-bottom:8px; font-size:0.88rem;">
                    <i class="fas fa-spinner fa-spin"></i> Yanıt bekleniyor...
                </div>`;
            messages.scrollTop = messages.scrollHeight;

            try {
                const response = await fetch('/Chatbot/Ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });
                const data = await response.json();

                document.getElementById(loadingId).remove();
                messages.innerHTML += `
                    <div style="background:#e8e8e8; padding:10px 12px; border-radius:8px; margin-bottom:8px; font-size:0.88rem;">
                        ${data.reply}
                    </div>`;
            } catch (e) {
                document.getElementById(loadingId).remove();
                messages.innerHTML += `
                    <div style="background:#ffe0e0; padding:10px 12px; border-radius:8px; margin-bottom:8px; font-size:0.88rem;">
                        Bağlantı hatası oluştu.
                    </div>`;
            }

            messages.scrollTop = messages.scrollHeight;
        }
    </script>
</body>
</html>