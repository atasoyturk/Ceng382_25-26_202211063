@model List<tastemam.Models.Menu>

@{
    ViewData["Title"] = "Ana Sayfa";
    var kategori = ViewData["Kategori"] as string;
    var mapsApiKey = ViewData["MapsApiKey"] as string;
    var lat = ViewData["Lat"];
    var lng = ViewData["Lng"];
}

<div class="container fade-in-up">
    @if (string.IsNullOrEmpty(kategori))
    {
        <div class="hero-section text-center">
            <p class="hero-subtitle">Catering & Organizasyon</p>
            <h1 class="hero-title">Her özel an için<br />rafine lezzetler.</h1>
            <p class="hero-text">
                Düğünden kurumsal etkinliklere kadar, profesyonel dokunuşlarla
                hazırlanmış özel menü seçeneklerimizi keşfedin.
            </p>
            <div class="hero-divider"></div>
            <p class="hero-hint"><i class="fas fa-arrow-left me-2"></i> Başlamak için bir kategori seçin</p>
        </div>
    }
    else
    {
        <div class="category-header">
            <p class="hero-subtitle">Menüler</p>
            <h2 class="hero-title">@kategori</h2>
        </div>

        <!-- KONUM FİLTRESİ -->
        <div class="mb-4 p-3" style="background:#f9f9f9; border-radius:8px; border-left: 3px solid #C9A84C;">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <button class="btn btn-sm btn-outline-danger" onclick="getLocation()">
                    <i class="fas fa-map-marker-alt me-1"></i> Konumuma Göre Filtrele
                </button>
                <select id="radiusSelect" class="form-select form-select-sm" style="width:150px;">
                    <option value="10">10 km</option>
                    <option value="25">25 km</option>
                    <option value="50" selected>50 km</option>
                    <option value="100">100 km</option>
                </select>
                @if (lat != null)
                {
                    <span class="text-muted" style="font-size:0.85rem;"><i class="fas fa-check-circle text-success me-1"></i>Konum aktif</span>
                    <a href="/Home/Index?kategori=@kategori" class="btn btn-sm btn-outline-secondary">Filtreyi Kaldır</a>
                }
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state text-center py-5">
                <p class="text-muted">Bu kategoride henüz bir menü bulunmuyor.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="menu-card h-100">
                            <div class="menu-image-wrapper">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" alt="@item.Name" class="menu-image" />
                                }
                                else
                                {
                                    <div class="menu-image-placeholder">
                                        <i class="fas fa-utensils"></i>
                                    </div>
                                }
                            </div>
                            <div class="menu-card-body">
                                <span class="card-badge">Özel Seçim</span>
                                <h5 class="card-title">
                                    <a asp-action="Detail" asp-route-id="@item.ID">@item.Name</a>
                                </h5>
                                <p class="card-description">@item.Description</p>
                                <div class="card-footer-price">
                                    <strong>@item.Price ₺</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@section Scripts {
    <script src="https://maps.googleapis.com/maps/api/js?key=@mapsApiKey"></script>
    <script>
        function getLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function(position) {
                    var lat = position.coords.latitude;
                    var lng = position.coords.longitude;
                    var radius = document.getElementById('radiusSelect').value;
                    var kategori = '@kategori';
                    window.location.href = '/Home/Index?kategori=' + kategori + '&lat=' + lat + '&lng=' + lng + '&radius=' + radius;
                }, function() {
                    alert('Konum alınamadı. Lütfen konum iznini etkinleştirin.');
                });
            } else {
                alert('Tarayıcınız konum özelliğini desteklemiyor.');
            }
        }
    </script>
}