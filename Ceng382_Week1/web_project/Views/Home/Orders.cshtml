@using X.PagedList
@model X.PagedList.IPagedList<tastemam.Models.Order>

@{
    ViewData["Title"] = "Siparişlerim";
    var search = ViewData["Search"] as string;
}

<div style="padding: 10px 0 30px;">
    <p style="font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; color: #C0392B; margin-bottom: 6px;">Hesabım</p>
    <h2 style="font-family: 'Playfair Display', serif; font-size: 1.8rem; color: #1a1a1a;">Siparişlerim</h2>
</div>

<!-- FİLTRE -->
<div class="mb-4 p-3" style="background:#f9f9f9; border-radius:8px; border-left: 3px solid #C9A84C;">
    <form method="get" asp-action="Orders" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label mb-1" style="font-size:0.8rem;">Arama</label>
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Menü adı..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-danger w-100">Filtrele</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Orders" class="btn btn-sm btn-outline-secondary w-100">Temizle</a>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Henüz sipariş bulunmuyor.</p>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-bordered table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sipariş No</th>
                        <th>Tarih</th>
                        <th>Ürünler</th>
                        <th>Toplam</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.ID</td>
                            <td style="font-size:0.85rem;">@order.Date.ToString("dd.MM.yyyy HH:mm")</td>
                            <td style="font-size:0.85rem;">
                                @string.Join(", ", order.OrderItems.Select(i => i.Menu?.Name ?? "-"))
                            </td>
                            <td><strong style="color:#C0392B;">@order.TotalPrice ₺</strong></td>
                            <td><span class="badge bg-warning">@order.State</span></td>
                            <td>
                                <a asp-controller="Order" asp-action="DownloadReceipt" asp-route-id="@order.ID"
                                   class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="fas fa-file-pdf"></i>
                                </a>
                                <a asp-controller="Rating" asp-action="Create" asp-route-orderId="@order.ID"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-star"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PAGINATION -->
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.PageNumber - 1)&search=@search">Önceki</a>
                </li>
            }
            @for (int i = 1; i <= Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="?page=@i&search=@search">@i</a>
                </li>
            }
            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.PageNumber + 1)&search=@search">Sonraki</a>
                </li>
            }
        </ul>
    </nav>
}