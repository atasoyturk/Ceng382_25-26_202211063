@{
    ViewData["Title"] = "Dashboard";
    var totalOrders = (int)ViewData["TotalOrders"];
    var totalSpent = (decimal)ViewData["TotalSpent"];
    var completedOrders = (int)ViewData["CompletedOrders"];
    var recentOrders = ViewData["RecentOrders"] as List<tastemam.Models.Order>;
}

<div style="padding: 10px 0 30px;">
    <p style="font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; color: #C0392B; margin-bottom: 6px;">Hesabım</p>
    <h2 style="font-family: 'Playfair Display', serif; font-size: 1.8rem; color: #1a1a1a;">Dashboard</h2>
</div>

<!-- İSTATİSTİK KARTLARI -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <i class="fas fa-shopping-basket fa-2x mb-3" style="color: #C0392B;"></i>
            <h3 style="font-family: 'Playfair Display', serif;">@totalOrders</h3>
            <p class="text-muted mb-0">Toplam Sipariş</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <i class="fas fa-check-circle fa-2x mb-3" style="color: #C9A84C;"></i>
            <h3 style="font-family: 'Playfair Display', serif;">@completedOrders</h3>
            <p class="text-muted mb-0">Tamamlanan Sipariş</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <i class="fas fa-lira-sign fa-2x mb-3" style="color: #C0392B;"></i>
            <h3 style="font-family: 'Playfair Display', serif;">@totalSpent ₺</h3>
            <p class="text-muted mb-0">Toplam Harcama</p>
        </div>
    </div>
</div>

<!-- SON SİPARİŞLER -->
<div class="card border-0 shadow-sm">
    <div class="card-header" style="background: #1a1a1a; color: white; border-radius: 8px 8px 0 0;">
        <i class="fas fa-history me-2"></i>Son Siparişler
    </div>
    <div class="card-body p-0">
        @if (recentOrders == null || !recentOrders.Any())
        {
            <p class="text-muted p-3">Henüz sipariş bulunmuyor.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Sipariş No</th>
                        <th>Tarih</th>
                        <th>Ürünler</th>
                        <th>Toplam</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in recentOrders)
                    {
                        <tr>
                            <td>#@order.ID</td>
                            <td style="font-size:0.85rem;">@order.Date.ToString("dd.MM.yyyy HH:mm")</td>
                            <td style="font-size:0.85rem;">
                                @string.Join(", ", order.OrderItems.Select(i => i.Menu?.Name ?? "-"))
                            </td>
                            <td><strong style="color:#C0392B;">@order.TotalPrice ₺</strong></td>
                            <td><span class="badge bg-warning">@order.State</span></td>
                            <td>
                                <a asp-controller="Order" asp-action="DownloadReceipt" asp-route-id="@order.ID"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-file-pdf"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>