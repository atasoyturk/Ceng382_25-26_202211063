@model tastemam.Models.Menu

@{
    ViewData["Title"] = @Model.Name;
}

<div class="row mt-4">
    <div class="col-md-5">
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath" class="img-fluid rounded shadow" style="width:100%; object-fit:cover;" />
        }
        else
        {
            <div style="height:300px; background:#f0f0f0;" class="d-flex align-items-center justify-content-center rounded">
                <span class="text-muted">Resim yok</span>
            </div>
        }
    </div>
    <div class="col-md-7">
        <h2>@Model.Name</h2>
        <span class="badge bg-danger mb-2">@Model.Category</span>
        <p class="text-muted">@Model.Description</p>
        <h4 class="text-danger">@Model.Price ₺</h4>

        @if (Model.CustomizationGroups != null && Model.CustomizationGroups.Any())
        {
            <hr />
            <h5>Özelleştirme Seçenekleri</h5>

            @foreach (var group in Model.CustomizationGroups)
            {
                <div class="mb-3">
                    <h6>
                        @group.Name
                        <span class="badge bg-secondary ms-1" style="font-size:0.7rem;">
                            @(group.Type == "removable" ? "Çıkarılabilir" :
                              group.Type == "addition" ? "Ekstra" : "Gruplu Seçim")
                        </span>
                    </h6>
                    <ul class="list-group">
                        @foreach (var option in group.Options)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    @option.Name
                                    @if (option.IsDefault)
                                    {
                                        <span class="badge bg-success ms-1">Varsayılan</span>
                                    }
                                </span>
                                <span class="text-muted">
                                    @if (option.PriceModifier > 0)
                                    {
                                        <span class="text-danger">+@option.PriceModifier ₺</span>
                                    }
                                    else
                                    {
                                        <span>Ücretsiz</span>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            }
        }

        @if (User.Identity.IsAuthenticated && User.IsInRole("User"))
        {
            <form asp-controller="Cart" asp-action="Add" method="post" class="mt-3">
                <input type="hidden" name="menuId" value="@Model.ID" />
                <input type="hidden" name="quantity" value="1" />

                @if (Model.CustomizationGroups != null && Model.CustomizationGroups.Any())
                {
                    @foreach (var group in Model.CustomizationGroups)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">@group.Name</label>
                            @foreach (var option in group.Options)
                            {
                                <div class="form-check">
                                    <input type="checkbox" name="selectedOptionIds" value="@option.ID"
                                        class="form-check-input"
                                        @(option.IsDefault ? "checked" : "") />
                                    <label class="form-check-label">
                                        @option.Name
                                        @if (option.PriceModifier > 0)
                                        {
                                            <span class="text-danger">(+@option.PriceModifier ₺)</span>
                                        }
                                    </label>
                                </div>
                            }
                        </div>
                    }
                }

                <div class="mb-3">
                    <label class="form-label">Adet</label>
                    <input type="number" name="quantity" value="1" min="1" class="form-control" style="width:100px;" />
                </div>

                <button type="submit" class="btn btn-danger">Sepete Ekle</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Geri Dön</a>
            </form>
        }
        else if (!User.Identity.IsAuthenticated)
        {
            <div class="mt-3">
                <a asp-controller="Account" asp-action="Login" class="btn btn-danger">
                    <i class="fas fa-sign-in-alt me-1"></i>Sipariş için giriş yapın
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Geri Dön</a>
            </div>
        }
        else
        {
            <div class="mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">Geri Dön</a>
            </div>
        }

        <hr class="mt-4" />

        <!-- RATING BİLGİLERİ -->
        <div class="row mt-3">
            <div class="col-md-6">
                <h6 style="font-family: 'Playfair Display', serif;">Menü Değerlendirmesi</h6>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span style="font-size:1.5rem; color:#C9A84C;">★</span>
                    <strong style="font-size:1.2rem;">@ViewData["MenuAvgRating"]</strong>
                    <span class="text-muted" style="font-size:0.85rem;">(@ViewData["MenuRatingCount"] değerlendirme)</span>
                </div>
            </div>
            <div class="col-md-6">
                <h6 style="font-family: 'Playfair Display', serif;">Caretaker Değerlendirmesi</h6>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span style="font-size:1.5rem; color:#C9A84C;">★</span>
                    <strong style="font-size:1.2rem;">@ViewData["CaretakerAvgRating"]</strong>
                    <span class="text-muted" style="font-size:0.85rem;">(@ViewData["CaretakerRatingCount"] değerlendirme)</span>
                </div>
                <p style="font-size:0.85rem; color:#888;">
                    <i class="fas fa-user me-1"></i>@ViewData["CaretakerEmail"]
                </p>
            </div>
        </div>

        <!-- YORUMLAR -->
        @{
            var comments = ViewData["MenuComments"] as List<tastemam.Models.Rating>;
        }
        @if (comments != null && comments.Any())
        {
            <div class="mt-4">
                <h6 style="font-family: 'Playfair Display', serif;">Yorumlar</h6>
                @foreach (var comment in comments)
                {
                    <div class="p-3 mb-2" style="background:#f9f9f9; border-radius:8px; border-left:3px solid #C9A84C;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span style="color:#C9A84C;">
                                @for (int i = 0; i < comment.Score; i++) { <span>★</span> }
                            </span>
                            <small class="text-muted">@comment.Date.ToString("dd.MM.yyyy")</small>
                        </div>
                        <p style="font-size:0.9rem; margin:0;">@comment.Comment</p>
                    </div>
                }
            </div>
        }

    </div>
</div>