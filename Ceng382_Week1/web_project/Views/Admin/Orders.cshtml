@using X.PagedList
@model X.PagedList.IPagedList<tastemam.Models.Order>

@{
    ViewData["Title"] = "Siparişler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p style="font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; color: #C0392B; margin-bottom: 6px;">Yönetim</p>
        <h2 style="font-family: 'Playfair Display', serif;">Siparişler</h2>
    </div>
    <span class="badge bg-secondary">@Model.TotalItemCount sipariş</span>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Henüz sipariş bulunmuyor.</p>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-bordered table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sipariş No</th>
                        <th>Müşteri</th>
                        <th>Tarih</th>
                        <th>Ürünler</th>
                        <th>Toplam</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.ID</td>
                            <td style="font-size:0.85rem;">@order.CustomerName</td>
                            <td style="font-size:0.85rem;">@order.Date.ToString("dd.MM.yyyy HH:mm")</td>
                            <td style="font-size:0.85rem;">
                                @string.Join(", ", order.OrderItems.Select(i => i.Menu?.Name ?? "-"))
                            </td>
                            <td><strong style="color:#C0392B;">@order.TotalPrice ₺</strong></td>
                            <td><span class="badge bg-warning">@order.State</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PAGINATION -->
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.PageNumber - 1)">Önceki</a>
                </li>
            }
            @for (int i = 1; i <= Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }
            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.PageNumber + 1)">Sonraki</a>
                </li>
            }
        </ul>
    </nav>
}