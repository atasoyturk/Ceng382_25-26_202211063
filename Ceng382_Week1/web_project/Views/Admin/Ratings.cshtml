@using X.PagedList
@model X.PagedList.IPagedList<tastemam.Models.Rating>

@{
    ViewData["Title"] = "Değerlendirmeler";
    var type = ViewData["Type"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p style="font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; color: #C0392B; margin-bottom: 6px;">Yönetim</p>
        <h2 style="font-family: 'Playfair Display', serif;">Değerlendirmeler</h2>
    </div>
    <span class="badge bg-secondary">@Model.TotalItemCount değerlendirme</span>
</div>

<!-- FİLTRE -->
<div class="mb-4 p-3" style="background:#f9f9f9; border-radius:8px; border-left: 3px solid #C9A84C;">
    <form method="get" asp-action="Ratings" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label mb-1" style="font-size:0.8rem;">Tür</label>
            <select name="type" class="form-select form-select-sm">
                <option value="">Tümü</option>
                <option value="Menu" selected="@(type == "Menu")">Menü</option>
                <option value="Caretaker" selected="@(type == "Caretaker")">Caretaker</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-danger w-100">Filtrele</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Ratings" class="btn btn-sm btn-outline-secondary w-100">Temizle</a>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Henüz değerlendirme bulunmuyor.</p>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-bordered table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Tür</th>
                        <th>Sipariş No</th>
                        <th>Menü</th>
                        <th>Puan</th>
                        <th>Yorum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rating in Model)
                    {
                        <tr>
                            <td style="font-size:0.85rem;">@rating.Date.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (rating.Type == "Menu")
                                {
                                    <span class="badge bg-danger">Menü</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Caretaker</span>
                                }
                            </td>
                            <td>#@rating.OrderID</td>
                            <td style="font-size:0.85rem;">@(rating.Menu?.Name ?? "—")</td>
                            <td>
                                <span style="color:#C9A84C;">
                                    @for (int i = 0; i < rating.Score; i++) { <span>★</span> }
                                </span>
                            </td>
                            <td style="font-size:0.85rem;">@(rating.Comment ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PAGINATION -->
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.PageNumber - 1)&type=@type">Önceki</a>
                </li>
            }
            @for (int i = 1; i <= Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="?page=@i&type=@type">@i</a>
                </li>
            }
            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.PageNumber + 1)&type=@type">Sonraki</a>
                </li>
            }
        </ul>
    </nav>
}