@using X.PagedList
@model X.PagedList.IPagedList<tastemam.Models.SystemLog>

@{
    ViewData["Title"] = "Sistem Logları";
    var eventType = ViewData["EventType"] as string;
    var level = ViewData["Level"] as string;
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 style="font-family: 'Playfair Display', serif;">Sistem Logları</h2>
    <span class="badge bg-secondary">@Model.TotalItemCount kayıt</span>
</div>

<!-- FİLTRELER -->
<div class="mb-4 p-3" style="background:#f9f9f9; border-radius:8px; border-left: 3px solid #C9A84C;">
    <form method="get" asp-action="Logs" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label mb-1" style="font-size:0.8rem;">Arama</label>
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Mesaj veya kullanıcı..." />
        </div>
        <div class="col-md-2">
            <label class="form-label mb-1" style="font-size:0.8rem;">Olay Tipi</label>
            <select name="eventType" class="form-select form-select-sm">
                <option value="">Tümü</option>
                <option value="Auth" selected="@(eventType == "Auth")">Auth</option>
                <option value="Order" selected="@(eventType == "Order")">Order</option>
                <option value="Payment" selected="@(eventType == "Payment")">Payment</option>
                <option value="Rating" selected="@(eventType == "Rating")">Rating</option>
                <option value="Error" selected="@(eventType == "Error")">Error</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label mb-1" style="font-size:0.8rem;">Seviye</label>
            <select name="level" class="form-select form-select-sm">
                <option value="">Tümü</option>
                <option value="Info" selected="@(level == "Info")">Info</option>
                <option value="Warning" selected="@(level == "Warning")">Warning</option>
                <option value="Error" selected="@(level == "Error")">Error</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-danger w-100">Filtrele</button>
        </div>
        <div class="col-md-2">
            <a href="/Admin/Logs" class="btn btn-sm btn-outline-secondary w-100">Temizle</a>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Kayıt bulunamadı.</p>
}
else
{
    <table class="table table-bordered table-sm align-middle">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>Olay</th>
                <th>Seviye</th>
                <th>Kullanıcı</th>
                <th>Mesaj</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr class="@(log.Level == "Error" ? "table-danger" : log.Level == "Warning" ? "table-warning" : "")">
                    <td style="font-size:0.85rem; white-space:nowrap;">@log.Date.ToString("dd.MM.yyyy HH:mm")</td>
                    <td><span class="badge bg-secondary">@log.EventType</span></td>
                    <td>
                        @if (log.Level == "Error")
                        {
                            <span class="badge bg-danger">Error</span>
                        }
                        else if (log.Level == "Warning")
                        {
                            <span class="badge bg-warning text-dark">Warning</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Info</span>
                        }
                    </td>
                    <td style="font-size:0.85rem;">@log.UserEmail</td>
                    <td style="font-size:0.85rem;">@log.Message</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- PAGINATION -->
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.PageNumber - 1)&eventType=@eventType&level=@level&search=@search">Önceki</a>
                </li>
            }
            @for (int i = 1; i <= Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="?page=@i&eventType=@eventType&level=@level&search=@search">@i</a>
                </li>
            }
            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.PageNumber + 1)&eventType=@eventType&level=@level&search=@search">Sonraki</a>
                </li>
            }
        </ul>
    </nav>
}