@model tastemam.Models.Menu

@{
    ViewData["Title"] = "Menü Düzenle";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <h2 class="mb-4">Menü Düzenle</h2>

        <form asp-action="Edit" asp-route-id="@Model.ID" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Menü Adı</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label">Fiyat</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label">Kategori</label>
                <select asp-for="Category" class="form-select">
                    <option value="">Seçiniz</option>
                    <option value="Düğün">Düğün</option>
                    <option value="Kurumsal">Kurumsal</option>
                    <option value="Özel Gün">Özel Gün</option>
                    <option value="Mezuniyet">Mezuniyet</option>
                    <option value="Kokteyl">Kokteyl</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Mevcut Resim</label><br />
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" width="120" height="90" style="object-fit:cover;" class="mb-2" />
                }
                else
                {
                    <span class="text-muted">Resim yok</span>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Yeni Resim (opsiyonel)</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>

            <button type="submit" class="btn btn-danger w-100">Güncelle</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">İptal</a>
        </form>
    </div>
</div>