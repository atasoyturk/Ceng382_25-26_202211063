<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - lab3</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lab3.styles.css" asp-append-version="true" />
    <style>
        body { display: flex; flex-direction: column; min-height: 100vh; }
        .page-shell { flex: 1; }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="brand">CENG Web Demo</div>
        <nav class="topnav" aria-label="Top Menu">
            <a class="topnav__link" asp-area="" asp-page="/Index">Home</a>
            <a class="topnav__link" asp-area="" asp-page="/Privacy">Privacy</a>
        </nav>
        <div class="ms-auto d-flex align-items-center">
            <partial name="_LoginPartial" />
        </div>
    </header>

    <div class="layout page-shell">
        <aside class="sidebar" aria-label="Side Menu">
            <h2 class="sidebar__title">Menu</h2>
            <a class="sidebar__link is-active" href="#">Dashboard</a>
            <a class="sidebar__link" href="#">Assignments</a>
            <a class="sidebar__link" href="#">Resources</a>
            <a class="sidebar__link" href="#">Schedule</a>
            <a class="sidebar__link" href="#">Settings</a>
        </aside>

        <main role="main" class="content pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - lab3 - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
