@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- Kullanıcılar Tablosu Kartı -->
<section class="card mb-4">
    <h2 class="card__title">Kayıtlı Kullanıcılar</h2>
    <div class="tableWrap">
        <table class="dataTable table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Fotoğraf</th>
                    <th>Kullanıcı Adı</th>
                    <th>E-posta</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.AppUsers)
                {
                    <tr>
                        <td>
                            @if (user.PhotoBase64 != null)
                            {
                                <img src="data:@user.PhotoContentType;base64,@user.PhotoBase64"
                                     style="width:48px;height:48px;object-fit:cover;border-radius:50%;" />
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Öğrenci Başarı Tablosu Kartı -->
<section class="card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Öğrenci Başarı Tablosu</h2>
        <form method="post">
            <button asp-page-handler="Calculate" class="btn btn-primary">Not Hesapla</button>
        </form>
    </div>

    <div class="tableWrap">
        <table class="dataTable table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Öğrenci</th>
                    <th>Vize</th>
                    <th>Final</th>
                    <th>Harf Notu</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Students)
                {
                    <tr>
                        <td>@s.Id</td>
                        <td>@s.Name</td>
                        <td>@s.Midterm</td>
                        <td>@s.Final</td>
                        <td><strong>@s.Grade</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="alert alert-secondary mt-2">
        Hesaplama: %40 Vize + %60 Final
    </div>
</section>

<!-- Galeri Kartı -->
<section class="card mb-4">
    <h2 class="card__title">Resim Galerisi</h2>

    <!-- JS Yöntemi: Sadece tarayıcıda önizleme, veritabanına kaydetmez -->
    <div class="mb-3">
        <h5>JS Yöntemi</h5>
        <input type="file" id="jsFileInput" accept="image/*" class="form-control mb-2" style="max-width:350px;" />
        <div id="jsPreviewArea" class="d-flex flex-wrap gap-2 mt-2"></div>
    </div>

    <!-- C# Yöntemi: Sunucuya yükle, veritabanına kaydet -->
    <div class="mb-3">
        <h5>C# Yöntemi</h5>
        <form method="post" enctype="multipart/form-data">
            <div class="d-flex gap-2 align-items-center">
                <input type="file" name="Upload" accept="image/*" class="form-control" style="max-width:350px;" />
                <button asp-page-handler="Upload" class="btn btn-success">Yükle</button>
            </div>
        </form>
    </div>

    <!-- Veritabanındaki resimler -->
    <div class="d-flex flex-wrap gap-3 mt-3">
        @foreach (var img in Model.GalleryImages)
        {
            <div class="text-center">
                <img src="data:@img.ContentType;base64,@Convert.ToBase64String(img.Data)"
                     style="width:120px;height:120px;object-fit:cover;border:1px solid #ccc;border-radius:6px;" />
                <div class="text-muted" style="font-size:0.75rem;">@img.FileName</div>
            </div>
        }
        @if (!Model.GalleryImages.Any())
        {
            <p class="text-muted">Henüz resim yüklenmedi.</p>
        }
    </div>
</section>

<!-- Güvenlik Analizi Kartı -->
<section class="card mb-4">
    <h2 class="card__title">Güvenlik Analizi</h2>
    <div class="alert alert-warning">
        <strong> Dosya Yükleme Kısıtlaması Eksikliği</strong>
    </div>
    <p>
        <strong>Açıklama:</strong> Galeri yükleme özelliğinde sunucu tarafında yüklenen dosyanın
        türü yalnızca <code>ContentType</code> başlığına bakılarak kontrol edilmektedir.
        Bu başlık istemci tarafından gönderildiği için kullanıcı tarafından kolayca değiştirilebilir.
        Örneğin bir saldırgan, <code>.exe</code> ya da <code>.cshtml</code> uzantılı bir dosyayı
        <code>image/jpeg</code> içerik tipiyle yükleyebilir.
    </p>
    <p>
        <strong>Nerede Görünür:</strong> <code>Index.cshtml.cs</code> içindeki
        <code>OnPostUpload()</code> metodunda dosya türü doğrulaması yapılmamaktadır.
    </p>
    <p>
        <strong>Olası Sonuçlar:</strong> Zararlı bir dosya sunucuya yüklenirse; sunucu tarafı
        kod çalıştırma (Remote Code Execution), yetkisiz veri erişimi veya uygulamanın
        ele geçirilmesi gibi kritik sonuçlar doğurabilir.
    </p>
    <p class="text-muted">
        <em>Not: Bu rapor amaçlı olarak yalnızca açığı tanımlamaktadır; düzeltme uygulanmamıştır.</em>
    </p>
</section>

@section Scripts {
<script>
    document.getElementById('jsFileInput').addEventListener('change', function () {
        const previewArea = document.getElementById('jsPreviewArea');
        previewArea.innerHTML = '';
        const files = this.files;
        for (let i = 0; i < files.length; i++) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.style.cssText = 'width:100px;height:100px;object-fit:cover;border:1px solid #ccc;border-radius:6px;';
                previewArea.appendChild(img);
            };
            reader.readAsDataURL(files[i]);
        }
    });
</script>
}
