@model IEnumerable<Northwind.Mvc.Models.ShipperContactInfo>

@{
    ViewData["Title"] = "Shipper Contact Info";
    var activeList = ViewBag.ActiveList as List<Northwind.Mvc.Models.ShipperContactInfo>;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

<h2>Tüm Kayıtlar</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ContactInfoID</th>
            <th>ShipperID</th>
            <th>Email</th>
            <th>Website</th>
            <th>Phone</th>
            <th>Address</th>
            <th>City</th>
            <th>Country</th>
            <th>PostalCode</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ContactInfoId</td>
                <td>@item.ShipperId</td>
                <td>@item.Email</td>
                <td>@item.Website</td>
                <td>@item.Phone</td>
                <td>@item.Address</td>
                <td>@item.City</td>
                <td>@item.Country</td>
                <td>@item.PostalCode</td>
                <td>@(item.IsActive ? "Yes" : "No")</td>
                <td>
                    <a href="/Home/Edit/@item.ContactInfoId" class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil-fill"></i>
                    </a>
                    <button class="btn btn-sm btn-danger"
                            onclick="showHardDeleteModal(@item.ContactInfoId)">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<h2 class="mt-5">Active Records</h2>

<table class="table table-striped table-bordered">
    <thead class="table-success">
        <tr>
            <th>ContactInfoID</th>
            <th>ShipperID</th>
            <th>Email</th>
            <th>Website</th>
            <th>Phone</th>
            <th>Address</th>
            <th>City</th>
            <th>Country</th>
            <th>PostalCode</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in activeList!)
        {
            <tr>
                <td>@item.ContactInfoId</td>
                <td>@item.ShipperId</td>
                <td>@item.Email</td>
                <td>@item.Website</td>
                <td>@item.Phone</td>
                <td>@item.Address</td>
                <td>@item.City</td>
                <td>@item.Country</td>
                <td>@item.PostalCode</td>
                <td>@(item.IsActive ? "Yes" : "No")</td>
                <td>
                    <button class="btn btn-sm btn-danger"
                            onclick="showSoftDeleteModal(@item.ContactInfoId)">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!--hard delete  -->
<div class="modal fade" id="hardDeleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Are you sure?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                This record will be permanently deleted from the database. Do you want to continue?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="hardDeleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Soft Delete  -->
<div class="modal fade" id="softDeleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Are you sure?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                This record will be marked as inactive. Do you want to continue?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="softDeleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Yes</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function showHardDeleteModal(id) {
        document.getElementById('hardDeleteForm').action = '/Home/HardDelete/' + id;
        var modal = new bootstrap.Modal(document.getElementById('hardDeleteModal'));
        modal.show();
    }

    function showSoftDeleteModal(id) {
        document.getElementById('softDeleteForm').action = '/Home/SoftDelete/' + id;
        var modal = new bootstrap.Modal(document.getElementById('softDeleteModal'));
        modal.show();
    }
</script>